{
  "name": "dsh-plugin-quick-resume",
  "version": "0.2.1",
  "private": false,
  "description": "A row of quick-phrase buttons in the DSH composer: one click sends a saved phrase (default 请继续) so a stalled agent keeps working; buttons, labels, icons, and phrases are editable in place.",
  "type": "module",
  "license": "MIT",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quick-phrases",
    "composer",
    "agent"
  ],
  "homepage": "https://github.com/yuna78/dsh-quick-resume#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuna78/dsh-quick-resume.git"
  },
  "bugs": {
    "url": "https://github.com/yuna78/dsh-quick-resume/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "prepublishOnly": "node verify/smoke.mjs"
  },
  "author": "Yuna"
}
